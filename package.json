{
  "name": "chatbot-testing-promptfoo",
  "version": "1.0.0",
  "description": "Promptfoo-based test suite for chatbot/conversational AI evaluation and LLM API testing.",
  "main": "index.js",
  "scripts": {
    "eval": "promptfoo eval",
    "eval:multiturn": "promptfoo eval -c promptfooconfig.multiturn.yaml",
    "redteam:generate": "promptfoo redteam generate -c promptfooconfig.redteam.yaml -o promptfooconfig.redteam.generated.yaml",
    "redteam:eval": "promptfoo redteam eval -c promptfooconfig.redteam.generated.yaml -j 2 --delay 1000 -o redteam-report.html",
    "view": "promptfoo view"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "dotenv": "^17.4.2",
    "promptfoo": "^0.122.0"
  }
}
